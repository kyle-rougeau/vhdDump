library ieee; 
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity mplx421 is
Port (v_vec: in unsigned(3 downto 0);
      s_vec: in unsigned(1 downto 0);
      w : out STD_LOGIC);
end mplx421;


--architecture combinational of mplx421 is
--signal w_sig0, w_sig1: STD_LOGIC;
--begin

--M0: entity work.mplx221 port map (v0 => v_vec(0), v1 => v_vec(1), s => s_vec(0), w => w_sig0);
--M1: entity work.mplx221 port map (v0 => v_vec(2), v1 => v_vec(3), s => s_vec(0), w => w_sig1);
--M2: entity work.mplx221 port map (v0 => w_sig0,   v1 => w_sig1,   s => s_vec(1), w => w     );

--end combinational;

architecture sequential of mplx421 is
begin

process
begin
for v_dummy in 0 to 15 loop
for s_dummy in 0 to 3 loop
wait for 100ps;

w <= v_vec(to_integer(s_vec));

s_vec <= s_vec + 1;
end loop;
v_vec <= v_vec + 1;
end loop;
wait;
end process;

end sequential;
